# Add real values securely to Vercel Project Settings > Environment Variables.
# Do not commit credentials or paste them into chat.
ERP_DATABASE_URL=libsql://YOUR-DATABASE-YOUR-ORG.turso.io
ERP_DATABASE_TOKEN=
ERP_SETUP_TOKEN=
ERP_COOKIE_SECURE=1
# Vercel functions do not run a persistent background backup worker.
ERP_BACKUP_INTERVAL_HOURS=0
